{
  "name": "adoption-api-functional-tests",
  "version": "1.0.0",
  "description": "API de adopciones con tests funcionales y Docker",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec"
  },
  "keywords": [
    "express",
    "adoptions",
    "functional-tests",
    "docker"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
